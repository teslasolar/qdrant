{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tag-base",
  "title": "Base Tag UDT",
  "description": "Reusable base structure for all tag.json files",
  "type": "object",
  "required": ["UUID", "ISA_Level", "Directory_Path", "Title"],
  "properties": {
    "UUID": {
      "type": "string",
      "description": "Unique identifier",
      "pattern": "^[a-f0-9-]+$"
    },
    "ISA_Level": {
      "type": "string",
      "enum": ["L0_Physical", "L1_Control", "L2_Supervisory", "L3_MES", "L4_Business"]
    },
    "Directory_Path": {
      "type": "string",
      "pattern": "^/"
    },
    "Directory_Name": {
      "type": "string"
    },
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    },
    "Icon": {
      "type": "string"
    },
    "Color_Scheme": {
      "type": "string",
      "enum": ["green", "blue", "purple", "orange", "red", "cyan"]
    },
    "Parent_Path": {
      "type": ["string", "null"]
    }
  }
}
