{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "feature-udt",
  "title": "Feature UDT",
  "description": "Reusable feature structure",
  "type": "object",
  "required": ["title", "description", "icon"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "icon": {
      "type": "string",
      "maxLength": 10
    }
  }
}
