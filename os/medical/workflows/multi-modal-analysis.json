{
  "uuid": "alf-multimodal-001",
  "type": "workflow",
  "category": "medical",
  "metadata": {
    "name": "Multi-Modal Analysis Workflow",
    "description": "Combines X-Ray, MRI, PET, and clinical data for enhanced detection accuracy",
    "version": "1.0.0",
    "created": "2025-01-17T00:00:00Z"
  },
  "enabled": true,
  "trigger": {
    "type": "tag-change",
    "condition": "medical.alfMultiModalEnabled === true"
  },
  "modalities": [
    {
      "name": "X-Ray (AlF Detection)",
      "type": "xray",
      "required": true,
      "weight": 0.35,
      "description": "Dual-energy X-ray for aluminum fluoride detection",
      "inputs": [
        {
          "name": "highEnergyImage",
          "type": "dicom",
          "required": true,
          "validation": {
            "energyLevel": 100,
            "minQuality": 0.8
          }
        },
        {
          "name": "lowEnergyImage",
          "type": "dicom",
          "required": false,
          "validation": {
            "energyLevel": 40,
            "minQuality": 0.8
          }
        }
      ],
      "processing": {
        "algorithm": "vision-transformer",
        "model": "vit-l-16-alf-detect",
        "outputs": [
          "alfConcentrations",
          "brainRegionAnalysis",
          "probability"
        ]
      },
      "tags": {
        "probability": "medical.alfXRayProbability",
        "confidence": "medical.alfXRayConfidence"
      }
    },
    {
      "name": "MRI (Structural Analysis)",
      "type": "mri",
      "required": false,
      "weight": 0.30,
      "description": "Structural brain imaging for volumetric analysis",
      "inputs": [
        {
          "name": "t1Weighted",
          "type": "dicom",
          "required": true,
          "validation": {
            "sequenceType": "T1",
            "minResolution": [1, 1, 1]
          }
        },
        {
          "name": "flairSequence",
          "type": "dicom",
          "required": false,
          "validation": {
            "sequenceType": "FLAIR"
          }
        }
      ],
      "processing": {
        "algorithm": "volumetric-analysis",
        "model": "brain-segmentation-v2",
        "features": [
          {
            "name": "hippocampalVolume",
            "normalRange": [3.5, 4.5],
            "unit": "cm³",
            "alzheimersThreshold": 3.0
          },
          {
            "name": "corticalThickness",
            "normalRange": [2.5, 3.5],
            "unit": "mm",
            "alzheimersThreshold": 2.0
          },
          {
            "name": "ventricularVolume",
            "normalRange": [20, 40],
            "unit": "cm³",
            "alzheimersThreshold": 50
          },
          {
            "name": "whiteHyperintensities",
            "normalRange": [0, 5],
            "unit": "count",
            "alzheimersThreshold": 10
          }
        ],
        "outputs": [
          "volumetricMeasurements",
          "atrophyScore",
          "probability"
        ]
      },
      "tags": {
        "probability": "medical.alfMRIProbability",
        "confidence": "medical.alfMRIConfidence",
        "hippocampalVolume": "medical.mriHippocampalVolume",
        "corticalThickness": "medical.mriCorticalThickness"
      }
    },
    {
      "name": "PET (Metabolic/Amyloid Imaging)",
      "type": "pet",
      "required": false,
      "weight": 0.25,
      "description": "PET imaging for amyloid/tau protein detection",
      "inputs": [
        {
          "name": "amyloidPET",
          "type": "dicom",
          "required": false,
          "validation": {
            "tracer": ["PIB", "Florbetapir", "Flutemetamol"],
            "minQuality": 0.7
          }
        },
        {
          "name": "tauPET",
          "type": "dicom",
          "required": false,
          "validation": {
            "tracer": ["Flortaucipir", "MK-6240"],
            "minQuality": 0.7
          }
        },
        {
          "name": "fdgPET",
          "type": "dicom",
          "required": false,
          "validation": {
            "tracer": "FDG",
            "minQuality": 0.7
          }
        }
      ],
      "processing": {
        "algorithm": "pet-quantification",
        "model": "amyloid-detector-v1",
        "features": [
          {
            "name": "amyloidSUVR",
            "normalRange": [0, 1.1],
            "unit": "SUVR",
            "alzheimersThreshold": 1.4
          },
          {
            "name": "tauSUVR",
            "normalRange": [0, 1.2],
            "unit": "SUVR",
            "alzheimersThreshold": 1.5
          },
          {
            "name": "glucoseMetabolism",
            "normalRange": [5, 10],
            "unit": "SUV",
            "alzheimersThreshold": 4.0
          }
        ],
        "outputs": [
          "amyloidLoad",
          "tauLoad",
          "metabolicReduction",
          "probability"
        ]
      },
      "tags": {
        "probability": "medical.alfPETProbability",
        "confidence": "medical.alfPETConfidence",
        "amyloidLoad": "medical.petAmyloidLoad",
        "tauLoad": "medical.petTauLoad"
      }
    },
    {
      "name": "Clinical Data",
      "type": "clinical",
      "required": false,
      "weight": 0.10,
      "description": "Clinical assessments and patient history",
      "inputs": [
        {
          "name": "cognitiveScores",
          "type": "json",
          "required": false,
          "schema": {
            "MMSE": {
              "type": "integer",
              "range": [0, 30]
            },
            "MoCA": {
              "type": "integer",
              "range": [0, 30]
            },
            "CDR": {
              "type": "float",
              "range": [0, 3]
            }
          }
        },
        {
          "name": "riskFactors",
          "type": "json",
          "required": false,
          "schema": {
            "age": "integer",
            "familyHistory": "boolean",
            "apoeE4": "boolean",
            "education": "integer",
            "cardiovascular": "boolean",
            "diabetes": "boolean"
          }
        },
        {
          "name": "symptoms",
          "type": "json",
          "required": false,
          "schema": {
            "memoryLoss": "boolean",
            "executiveDysfunction": "boolean",
            "languageImpairment": "boolean",
            "behavioralChanges": "boolean",
            "onsetAge": "integer",
            "durationMonths": "integer"
          }
        }
      ],
      "processing": {
        "algorithm": "clinical-risk-scoring",
        "model": "ensemble-clinical-v1",
        "outputs": [
          "riskScore",
          "probability"
        ]
      },
      "tags": {
        "probability": "medical.alfClinicalProbability",
        "riskScore": "medical.clinicalRiskScore"
      }
    }
  ],
  "fusionStrategy": {
    "method": "weighted-ensemble",
    "description": "Combines modality predictions using weighted averaging with confidence-based adjustment",
    "weightAdjustment": {
      "enabled": true,
      "method": "confidence-based",
      "formula": "weight * confidence"
    },
    "missingModalityHandling": {
      "method": "renormalize",
      "description": "Renormalize weights when modalities are missing"
    },
    "outputs": [
      {
        "name": "fusedAlzheimersProbability",
        "tag": "medical.alfFusedAlzheimersProbability",
        "formula": "weighted_average(xray.prob, mri.prob, pet.prob, clinical.prob)"
      },
      {
        "name": "fusedAutismProbability",
        "tag": "medical.alfFusedAutismProbability",
        "formula": "weighted_average(xray.prob, mri.prob, clinical.prob)"
      },
      {
        "name": "fusedConfidence",
        "tag": "medical.alfFusedConfidence",
        "formula": "sqrt(sum(weight_i^2 * confidence_i^2))"
      },
      {
        "name": "modalityAgreement",
        "tag": "medical.alfModalityAgreement",
        "formula": "1 - std_dev(probabilities) / mean(probabilities)"
      }
    ]
  },
  "workflow": {
    "steps": [
      {
        "id": "step-1",
        "name": "Validate Inputs",
        "action": "validateInputs",
        "description": "Validate all input images and data quality",
        "onError": "abort",
        "timeout": 30000
      },
      {
        "id": "step-2",
        "name": "Process X-Ray",
        "action": "processModality",
        "modality": "xray",
        "parallel": true,
        "timeout": 60000
      },
      {
        "id": "step-3",
        "name": "Process MRI",
        "action": "processModality",
        "modality": "mri",
        "parallel": true,
        "optional": true,
        "timeout": 120000
      },
      {
        "id": "step-4",
        "name": "Process PET",
        "action": "processModality",
        "modality": "pet",
        "parallel": true,
        "optional": true,
        "timeout": 120000
      },
      {
        "id": "step-5",
        "name": "Process Clinical Data",
        "action": "processModality",
        "modality": "clinical",
        "parallel": true,
        "optional": true,
        "timeout": 30000
      },
      {
        "id": "step-6",
        "name": "Fuse Results",
        "action": "fuseModalityResults",
        "dependsOn": ["step-2", "step-3", "step-4", "step-5"],
        "waitFor": "any-required",
        "timeout": 10000
      },
      {
        "id": "step-7",
        "name": "Generate Report",
        "action": "generateMultiModalReport",
        "dependsOn": ["step-6"],
        "timeout": 30000
      },
      {
        "id": "step-8",
        "name": "Publish Results",
        "action": "publishMQTT",
        "topic": "chazon/os/medical/alf-detect/multimodal/result",
        "dependsOn": ["step-7"],
        "timeout": 5000
      }
    ]
  },
  "reporting": {
    "template": "multi-modal-report",
    "includeModalityDetails": true,
    "includeConfidenceIntervals": true,
    "includeAgreementMetrics": true,
    "visualizations": [
      "probability-comparison",
      "modality-weights",
      "confidence-intervals",
      "agreement-matrix"
    ]
  },
  "performance": {
    "expectedImprovement": {
      "precision": 0.15,
      "recall": 0.12,
      "f1Score": 0.13,
      "description": "Expected performance improvement over single-modality analysis"
    },
    "clinicalBenefit": "Multi-modal fusion reduces false positives by ~40% and false negatives by ~35% compared to X-ray alone"
  }
}
