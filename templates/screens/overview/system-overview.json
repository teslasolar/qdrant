      "bindings": {
        "tags": [
          "modules.loaded",
          "modules.active"
        ]
      }
    },
    {
      "uuid": "comp-004",
      "type": "status-card",
      "position": {
        "x": 3,
        "y": 0,
        "width": 1,
        "height": 1
      },
      "config": {
        "title": "Boot",
        "icon": "🚀",
        "navigationPath": "/os/boot/"
      },
      "bindings": {
        "tags": [
          "boot.status",
          "boot.phase"
        ]
      }
    },
    {
      "uuid": "comp-005",
      "type": "trend-chart",
      "position": {
        "x": 0,
        "y": 1,
        "width": 2,
        "height": 2
      },
      "config": {
        "title": "System Performance",
        "chartType": "line",
        "timeRange": 3600
      },
      "bindings": {
        "tags": [
          "system.cpu",
          "system.memory",
          "system.network"
        ]
      }
    },
    {
      "uuid": "comp-006",
      "type": "alarm-summary",
      "position": {
        "x": 2,
        "y": 1,
        "width": 2,
        "height": 1
      },
      "config": {
        "title": "Active Alarms",
        "maxDisplay": 5
      },
      "bindings": {
        "tags": [
          "alarms.active",
          "alarms.unacknowledged"
        ]
      }
    },
    {
      "uuid": "comp-007",
      "type": "tag-summary",
      "position": {
        "x": 2,
        "y": 2,
        "width": 2,
        "height": 1
      },
      "config": {
        "title": "Tag Statistics",
        "showQuality": true
      },
      "bindings": {
        "tags": [
          "tags.total",
          "tags.goodQuality",
          "tags.badQuality"
        ]
      }
    }
