        "navigationPath": "/os/backend/"
      },
      "bindings": {
        "tags": [
          "backend.status",
          "backend.responseTime"
        ]
      }
    },
    {
      "uuid": "comp-003",
      "type": "status-card",
      "position": {
        "x": 2,
        "y": 0,
        "width": 1,
        "height": 1
