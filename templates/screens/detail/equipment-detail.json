    {
      "uuid": "comp-d003",
      "type": "gauge",
      "position": {
        "x": 2,
        "y": 1,
        "width": 1,
        "height": 1
      },
      "config": {
        "title": "Temperature",
        "units": "°C",
        "min": 0,
        "max": 150,
        "alarmHigh": 120
      },
      "bindings": {
        "tags": ["equipment.temperature"]
      }
    },
    {
      "uuid": "comp-d004",
      "type": "gauge",
      "position": {
        "x": 2,
        "y": 2,
        "width": 1,
        "height": 1
      },
      "config": {
        "title": "Pressure",
        "units": "PSI",
        "min": 0,
        "max": 100,
        "alarmLow": 20,
        "alarmHigh": 90
      },
      "bindings": {
        "tags": ["equipment.pressure"]
      }
    },
    {
      "uuid": "comp-d005",
      "type": "control-panel",
      "position": {
        "x": 0,
        "y": 3,
        "width": 3,
        "height": 1
      },
      "config": {
        "buttons": [
